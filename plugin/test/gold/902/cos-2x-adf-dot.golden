digraph cos_2x_adf {
  margin=0
  compound=true
  rankdir=LR
  node [shape=Mrecord]
  edge [fontsize=8,fontcolor=indigo]
  bgcolor=transparent
  nslimit=20
  subgraph clusterc0 { label=""; color=white; margin=0; c0 [label="{In|{<Out0>}}"] }
  subgraph clusterc54 { label=""; color=white; margin=0; c54 [label="{2.0|{<Out0>}}"] }
  subgraph clusterc112 { label=""; color=white; margin=0; c112 [label="{{<In0>|<In1>}|\×|{<Out0>}}"] }
  subgraph clusterc221 { label=""; color=white; margin=0; c221 [label="{{<In0>}|cos|{<Out0>}}"] }
  subgraph clusterc222 { label=""; color=white; margin=0; c222 [label="{{<In0>}|sin|{<Out0>}}"] }
  subgraph cluster_255 {
    margin=8
    fontsize=20
    labeljust=r
    color=DarkGreen
    c251 [label="{{<In0>|<In1>}|\×|{<Out0>}}"]
    c252 [label="{{<In0>|<In1>}|\×|{<Out0>}}"]
    c250 [label="{In|{<Out0>}}"]
    c254 [label="{{<In0>}|Out}"]
    c253 [label="{{<In0>}|negate|{<Out0>}}"]
    c54:Out0 -> c251:In0 [label="Double"]
    c250:Out0 -> c251:In1 [label="Double"]
    c222:Out0 -> c252:In0 [label="Double"]
    c251:Out0 -> c252:In1 [label="Double"]
    c253:Out0 -> c254:In0 [label="Double"]
    c252:Out0 -> c253:In0 [label="Double"]
  }
  subgraph clusterc256 { label=""; color=white; margin=0; c256 [label="{{<In0>|<In1>}|Out}"] }
  c0:Out0 -> c112:In0 [label="Double"]
  c54:Out0 -> c112:In1 [label="Double"]
  c112:Out0 -> c221:In0 [label="Double"]
  c112:Out0 -> c222:In0 [label="Double"]
  c221:Out0 -> c256:In0 [label="Double"]
  c254 -> c256:In1 [ltail=cluster_255,label="Double ’ Double"]
}
