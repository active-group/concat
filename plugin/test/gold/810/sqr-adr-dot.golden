digraph sqr_adr {
  margin=0
  compound=true
  rankdir=LR
  node [shape=Mrecord]
  edge [fontsize=8,fontcolor=indigo]
  bgcolor=transparent
  nslimit=20
  subgraph clusterc0 { label=""; color=white; margin=0; c0 [label="{In|{<Out0>}}"] }
  subgraph clusterc53 { label=""; color=white; margin=0; c53 [label="{{<In0>|<In1>}|\×|{<Out0>}}"] }
  subgraph cluster_164 {
    margin=8
    fontsize=20
    labeljust=r
    color=DarkGreen
    c161 [label="{{<In0>|<In1>}|\×|{<Out0>}}"]
    c162 [label="{{<In0>|<In1>}|+|{<Out0>}}"]
    c160 [label="{In|{<Out0>}}"]
    c163 [label="{{<In0>}|Out}"]
    c0:Out0 -> c161:In0 [label="Double"]
    c160:Out0 -> c161:In1 [label="Double"]
    c161:Out0 -> c162:In0 [label="Double"]
    c161:Out0 -> c162:In1 [label="Double"]
    c162:Out0 -> c163:In0 [label="Double"]
  }
  subgraph clusterc165 { label=""; color=white; margin=0; c165 [label="{{<In0>|<In1>}|Out}"] }
  c0:Out0 -> c53:In0 [label="Double"]
  c0:Out0 -> c53:In1 [label="Double"]
  c53:Out0 -> c165:In0 [label="Double"]
  c163 -> c165:In1 [ltail=cluster_164,label="Double ’ Double"]
}
