digraph cos_2x_adr {
  margin=0
  compound=true
  rankdir=LR
  node [shape=Mrecord]
  edge [fontsize=8,fontcolor=indigo]
  bgcolor=transparent
  nslimit=20
  subgraph clusterc0 { label=""; color=white; margin=0; c0 [label="{In|{<Out0>}}"] }
  subgraph clusterc61 { label=""; color=white; margin=0; c61 [label="{2.0|{<Out0>}}"] }
  subgraph clusterc179 { label=""; color=white; margin=0; c179 [label="{{<In0>|<In1>}|\×|{<Out0>}}"] }
  subgraph clusterc361 { label=""; color=white; margin=0; c361 [label="{{<In0>}|cos|{<Out0>}}"] }
  subgraph clusterc362 { label=""; color=white; margin=0; c362 [label="{{<In0>}|sin|{<Out0>}}"] }
  subgraph cluster_426 {
    margin=8
    fontsize=20
    labeljust=r
    color=DarkGreen
    c422 [label="{{<In0>|<In1>}|\×|{<Out0>}}"]
    c418 [label="{{<In0>|<In1>}|\×|{<Out0>}}"]
    c417 [label="{In|{<Out0>}}"]
    c425 [label="{{<In0>}|Out}"]
    c423 [label="{{<In0>}|negate|{<Out0>}}"]
    c61:Out0 -> c422:In0 [label="Double"]
    c418:Out0 -> c422:In1 [label="Double"]
    c362:Out0 -> c418:In0 [label="Double"]
    c417:Out0 -> c418:In1 [label="Double"]
    c423:Out0 -> c425:In0 [label="Double"]
    c422:Out0 -> c423:In0 [label="Double"]
  }
  subgraph clusterc427 { label=""; color=white; margin=0; c427 [label="{{<In0>|<In1>}|Out}"] }
  c0:Out0 -> c179:In0 [label="Double"]
  c61:Out0 -> c179:In1 [label="Double"]
  c179:Out0 -> c361:In0 [label="Double"]
  c179:Out0 -> c362:In0 [label="Double"]
  c361:Out0 -> c427:In0 [label="Double"]
  c425 -> c427:In1 [ltail=cluster_426,label="Double ’ Double"]
}
